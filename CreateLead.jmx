WDS.browser.findElement(By.xpath(&apos;//input[@name = &quot;Email&quot;]&apos;)).click()
WDS.browser.findElement(By.xpath(&apos;//input[@name = &quot;Email&quot;]&apos;)).sendKeys(&apos;test${__time(ddMMyyyyHHmmss,)}${__RandomString(5,abcdefghijklmnopqrstuvwxyz,)}@test.com&apos;)
Thread.sleep(5000)

WDS.sampleResult.sampleEnd()
