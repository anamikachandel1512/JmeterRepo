// Create an instance of WebDriverWait
WebDriverWait wait = new WebDriverWait(WDS.browser, timeout)

WDS.sampleResult.sampleStart()
WDS.browser.findElement(By.xpath(&apos;//button[text()=&quot;Save&quot;]&apos;)).click()

wait.until(ExpectedConditions.visibilityOfElementLocated(org.openqa.selenium.By.xpath(&apos;//button[text()= &quot;Edit&quot;]&apos;)))
WDS.sampleResult.sampleEnd()
Thread.sleep(5000)</stringProp>
