WDS.sampleResult.sampleStart()
WDS.browser.findElement(By.xpath(&quot;//input[@placeholder=&apos;Last Name&apos;]&quot;)).click()
WDS.browser.findElement(By.xpath(&quot;//input[@placeholder=&apos;Last Name&apos;]&quot;)).sendKeys(&apos;P_Last${__time(ddMMyyyyHHmmss,)}${__RandomString(5,abcdefghijklmnopqrstuvwxyz,)}&apos;)
Thread.sleep(2000)
WDS.browser.findElement(By.xpath(&quot;//input[@placeholder=&apos;First Name&apos;]&quot;)).click()
WDS.browser.findElement(By.xpath(&quot;//input[@placeholder=&apos;First Name&apos;]&quot;)).sendKeys(&apos;P_First${__time(ddMMyyyyHHmmss,)}${__RandomString(5,abcdefghijklmnopqrstuvwxyz,)}&apos;)
